{
  "name": "syncdraw-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "SyncDraw - Real-Time Collaborative Drawing Canvas",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"cyan,magenta\" \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "start": "npm run start -w server",
    "build": "npm run build -w server && npm run build -w client",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "typecheck": "npm run typecheck -w client && npm run typecheck -w server",
    "lint": "npm run lint -w client"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
