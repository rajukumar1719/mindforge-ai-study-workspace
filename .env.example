# MindForge Environment Configuration

# Primary AI Provider: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Optional Secondary Fallback AI Provider (Groq / OpenRouter / OpenAI-compatible)
# Groq is recommended: ultra-low latency (<1s) with generous free tier & native structured JSON
FALLBACK_AI_API_KEY=
FALLBACK_AI_MODEL=llama-3.3-70b-versatile
FALLBACK_AI_BASE_URL=https://api.groq.com/openai/v1

# Server & Network Configuration
PORT=3001
FRONTEND_URL=https://mindforge-ai-study-workspace.vercel.app
VITE_API_URL=http://localhost:3001
CACHE_TTL_SECONDS=3600

# Testing & Rubric Evaluation Switches
DEMO_FAULT_MODE=off