# MindForge Environment Configuration

# Provider 1 (Primary): Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Provider 2 (Secondary Fallback): Groq API (Fast 1-2s)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Provider 3 (Tertiary Fallback): OpenRouter API (~600ms)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Backward compatibility / Custom Fallback Base URL
FALLBACK_AI_API_KEY=
FALLBACK_AI_MODEL=llama-3.3-70b-versatile
FALLBACK_AI_BASE_URL=https://api.groq.com/openai/v1

# Server & Network Configuration
PORT=3001
FRONTEND_URL=https://mindforge-ai-study-workspace.vercel.app
VITE_API_URL=http://localhost:3001
CACHE_TTL_SECONDS=3600

# Testing & Rubric Evaluation Switches
DEMO_FAULT_MODE=off