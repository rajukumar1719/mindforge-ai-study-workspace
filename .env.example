# ==============================================================================
# SyncDraw Environment Configuration Template
# ==============================================================================
# This template documents all runtime and build-time environment variables used
# across the SyncDraw monorepo.
#
# Rule of Thumb:
# - Variables starting with VITE_* are bundled into the CLIENT at build time.
# - All other variables are private to the Node.js SERVER runtime.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER RUNTIME VARIABLES (server/.env or Cloud PaaS Environment Settings)
# ------------------------------------------------------------------------------

# HTTP / WebSocket server listen port.
# Automatically supplied by Cloud Platforms (e.g., Render, Railway, Heroku).
# Default if unset: 5000
PORT=5000

# Execution environment: 'development' | 'production' | 'test'
# In production, strict CORS origin checks and production security headers are enforced.
NODE_ENV=development

# Allowed frontend client origin(s) for HTTP and Socket.IO CORS verification.
# Supports a single origin or a comma-separated list of origins.
# In development, local loopbacks (http://localhost:* and http://127.0.0.1:*) are allowed.
# In production, ONLY origins listed here are accepted.
#
# Examples:
#   Local:      http://localhost:5173
#   Production: https://syncdraw.onrender.com,https://syncdraw-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Backward-compatible alias for CLIENT_ORIGIN (optional)
CLIENT_URL=http://localhost:5173


# ------------------------------------------------------------------------------
# 2. CLIENT BUILD-TIME VARIABLES (client/.env or Static Host Build Settings)
# ------------------------------------------------------------------------------

# The public URL of the deployed backend server (HTTP/HTTPS).
# Socket.IO client automatically connects to this gateway and upgrades to WSS
# when served over HTTPS.
#
# Examples:
#   Local:      http://localhost:5000
#   Production: https://syncdraw-api.onrender.com
VITE_API_URL=http://localhost:5000

# Backward-compatible alias for VITE_API_URL (optional)
VITE_SERVER_URL=http://localhost:5000

# Performance diagnostics overlay HUD (optional; defaults to false).
# Set to 'true' only if you want the FPS/latency diagnostic HUD visible by default.
# Users can always toggle it in the browser via query parameter: `?debug=true`
VITE_PERF_DEBUG=false
